@model IEnumerable<TX2.Models.HangSanXuat>

@{
    ViewBag.Title = "GetHangSx";
}

<h2>GetHangSx</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TenHang)
        </th>
        <th>
            Số lượng sản phẩm
        </th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TenHang)
        </td>
        <td>
            @item.SanPhams.Count()
        </td>
    </tr>
}

</table>
